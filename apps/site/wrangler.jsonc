{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-web",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // 바인딩 목록은 docs/common.md. id는 운영 리소스(로컬 wrangler dev는 .wrangler/에 따로 에뮬레이션)
  "d1_databases": [{ "binding": "DB", "database_name": "portfolio-web", "database_id": "bd597ce5-ef1f-41ad-b549-12f4cc7d2604", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "KV", "id": "923982f21f4b41d8ac46b2dbd45d415b" }],
  // 챗·RAG(docs/05-06-chat-rag.md). AI는 로컬에서도 원격 호출(무료 범위에 잡힌다), Vectorize는 로컬 에뮬레이션이 없어 원격 인덱스를 쓴다
  "ai": { "binding": "AI", "remote": true },
  "vectorize": [{ "binding": "VEC", "index_name": "portfolio-rag", "remote": true }],
  // RAG 원본(sources/, 비공개)과 이미지(media/, /media/*로 서빙). 로컬·운영 공용(docs/06-ingest.md)
  "r2_buckets": [{ "binding": "R2", "bucket_name": "portfolio-rag", "remote": true }],
  // 비밀이 아닌 설정값. 비밀은 .dev.vars(로컬) / wrangler secret put(운영)
  "vars": {
    "SITE_NAME": "yhy",
    // 운영 주소. 로컬은 .dev.vars 값이 우선한다(11/04 도메인 연결 — docs/guides/domain-setup.md)
    "BETTER_AUTH_URL": "https://bettercurl.dev"
  },
  // 커스텀 도메인(11/04). 배포하면 DNS 레코드와 인증서가 자동으로 생긴다. workers.dev 주소도 남는다
  "routes": [{ "pattern": "bettercurl.dev", "custom_domain": true }]
}
