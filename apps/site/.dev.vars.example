# 로컬 개발용 비밀값 예시. `cp .dev.vars.example .dev.vars` 후 채운다. (.dev.vars는 커밋 금지)
# 비어 있는 외부 키는 로컬에서 콘솔 출력으로 대체된다(메일·Telegram). Google은 버튼이 오류를 안내한다.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
# 도메인 전에는 onboarding@resend.dev (Resend 가입 이메일로만 발송) — docs/guides/resend-setup.md
MAIL_FROM=
LETTER_TO=
# 로컬 테스트 관리자 — 메일 대신 터미널에 로그인 링크가 찍힌다(docs/04-admin.md "로컬 테스트 어드민"). 운영에 쓰지 않는다
ADMIN_EMAILS=admin@test.local
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 2차: 챗 + RAG. CHAT_ENABLED=1일 때만 /api/chat이 열린다. 모델은 Workers AI(`AI` 바인딩)라 키가 없다.
CHAT_ENABLED=
CHAT_MONTHLY_TOKEN_CAP=
# 과금 폭탄 차단기(docs/guides/cost-guard.md). 비우면 기본값: 뉴런 8000, 챗 500턴, 메일 80/2800통, 레터 50통
AI_DAILY_NEURON_CAP=
CHAT_DAILY_TURN_CAP=
MAIL_DAILY_CAP=
MAIL_MONTHLY_CAP=
LETTER_DAILY_CAP=
# 긴급 차단 스위치(1이면 켜짐): 로그인 메일 중지, 레터 접수 중지
KILL_LOGIN_MAIL=
KILL_LETTERS=
# /admin/usage의 Cloudflare 통계 — 분석 읽기 전용 토큰(배포 토큰 금지)과 계정 ID
CF_ANALYTICS_TOKEN=
CF_ACCOUNT_ID=
