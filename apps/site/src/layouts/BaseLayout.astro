---
import '../styles/global.css';
import NavProgress from '../components/ui/NavProgress.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import Overlay from '../components/islands/Overlay';
import ChatDock from '../components/islands/ChatDock';
import { locales, t, type Locale } from '../i18n';
import { absolute, alternates, ogLocale } from '../lib/seo';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** og:type — 프로젝트 상세는 'article' */
  type?: 'website' | 'article';
  /** 이 페이지가 있는 언어(프로젝트 본문이 한 언어뿐일 때). 기본: 둘 다 */
  available?: readonly Locale[];
  /** 404 등 색인하지 않는 페이지 */
  noindex?: boolean;
}

const { locale, title, description, type = 'website', available = locales, noindex = false } = Astro.props;
const dict = t(locale);
// 탭 제목(11/05): 홈 `Yeonghun.y | iOS 개발자 · 빌더`, 그 밖 `페이지 — Yeonghun.y`(탭이 많아도 앞부분으로 구분). 크롬 탭 호버 카드도 이 제목을 보여 준다
const pageTitle = title ? `${title} — ${dict.site.name}` : `${dict.site.name} | ${dict.site.role}`;
const pageDescription = description ?? dict.site.description;
// SEO·GEO(docs/01-frontend.md): 절대 URL은 Astro.site에서. 도메인을 코드에 쓰지 않는다
const site = Astro.site!;
const path = Astro.url.pathname;
const canonical = absolute(site, path);
const alts = alternates(path, available);
// 홈은 챗 버튼이 처음엔 숨어 있다가 프로젝트가 나올 때쯤 나온다(src/lib/chat-fab.ts) — 깜빡임 없게 서버에서 숨긴 채로
const isHome = /^\/(ko|en)\/?$/.test(path);
---

<!doctype html>
<html lang={locale} data-fab={isHome ? 'hidden' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {alts.map((a) => <link rel="alternate" hreflang={a.locale} href={absolute(site, a.path)} />)}
          <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
          <meta property="og:type" content={type} />
          <meta property="og:site_name" content={dict.site.name} />
          <meta property="og:title" content={pageTitle} />
          <meta property="og:description" content={pageDescription} />
          <meta property="og:url" content={canonical} />
          <meta property="og:locale" content={ogLocale[locale]} />
          {alts.filter((a) => a.locale !== locale).map((a) => <meta property="og:locale:alternate" content={ogLocale[a.locale]} />)}
          {/* 공유 미리보기 이미지(11/05): 1200×630, scripts/hero/og.mjs가 만든다(pnpm site hero:og) */}
          <meta property="og:image" content={new URL('/og.png', site).href} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={dict.site.ogAlt} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={pageTitle} />
          <meta name="twitter:description" content={pageDescription} />
          <meta name="twitter:image" content={new URL('/og.png', site).href} />
        </>
      )
    }
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-[var(--radius)] focus:bg-surface focus:px-4 focus:py-2"
      >{dict.nav.skip}</a
    >
    <Header locale={locale} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <Overlay client:demand dict={dict} locale={locale} />
    {/* 2차 챗: 빌드 때 PUBLIC_CHAT_ENABLED=1일 때만 독을 넣는다(서버는 CHAT_ENABLED로 따로 잠금) */}
    {import.meta.env.PUBLIC_CHAT_ENABLED === '1' && <ChatDock client:demand dict={dict} locale={locale} />}
    <NavProgress />
    <script>
      import { initChatFab } from '../lib/chat-fab';
      import { initNoDrag } from '../lib/no-drag';
      initChatFab();
      initNoDrag();
    </script>
  </body>
</html>
