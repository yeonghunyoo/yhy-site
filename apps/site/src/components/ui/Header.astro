---
import { t, otherLocale, switchLocalePath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const other = otherLocale(locale);
---

<header
  class="sticky top-0 z-30 bg-bg/90 pt-[env(safe-area-inset-top)] backdrop-blur"
>
  <div class="container-page flex h-[var(--header-h)] items-center justify-between gap-2">
    <a href={`/${locale}/`} class="-ml-2 flex min-h-11 items-center px-2 font-display text-xl">{dict.intro.name}</a>
    <!-- 섹션 바로가기는 뺐다(11/05) — 홈 데스크톱은 왼쪽 플로팅 목차(src/lib/toc.ts) -->
    <nav class="flex items-center gap-1 font-mono text-xs text-muted" aria-label="Main">
      <a
        href={switchLocalePath(Astro.url.pathname, other)}
        hreflang={other}
        lang={other}
        class="flex min-h-11 items-center px-2">{dict.nav.language}</a
      >
    </nav>
  </div>
</header>

