---
// 프로젝트 상세 이미지(docs/01-frontend.md "프로젝트 상세 — 이미지"): 가로 슬라이드 + 누르면 전체 화면 뷰어(핀치 확대).
// 마크업만 여기, 동작은 src/lib/gallery.ts(React 없음). HTML style="" 금지(CSP) — 실행 중 위치는 스크립트가 CSSOM으로 쓴다.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import type { Dict } from '../../i18n';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  dict: Dict;
}

const { images, dict } = Astro.props;
const g = dict.project.gallery;
const many = images.length > 1;

// 목록 높이: 모바일 18rem(288px), md 이상 28rem(448px) — sizes는 이 높이 × 비율
const items = await Promise.all(
  images.map(async ({ src, alt }) => {
    const ar = src.width / src.height;
    // 원본보다 큰 폭은 만들지 않는다. 마지막 단계는 원본 폭(최대 1920)
    const widths = [...[480, 960, 1440].filter((w) => w < src.width), Math.min(src.width, 1920)];
    // 크게 보기: 긴 변 2400px 이하
    const scale = Math.min(1, 2400 / Math.max(src.width, src.height));
    const full = await getImage({ src, width: Math.round(src.width * scale), format: 'webp' });
    return {
      src,
      alt,
      widths,
      sizes: `(min-width: 768px) min(${Math.round(448 * ar)}px, 100vw), min(${Math.round(288 * ar)}px, 100vw)`,
      full: full.src,
      fullW: Math.round(src.width * scale),
      fullH: Math.round(src.height * scale),
    };
  }),
);
---

{
  items.length > 0 && (
    <section aria-label={g.label} class="mt-8 md:mt-10" data-gallery>
      <div class="relative">
        <div
          class="relative flex snap-x snap-mandatory gap-3 overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          data-track
        >
          {items.map((it, i) => (
            <button
              type="button"
              class="h-72 max-w-[calc(100vw-2rem)] shrink-0 snap-start cursor-zoom-in overflow-hidden rounded-[var(--radius)] border border-border bg-surface md:h-[28rem]"
              data-open={i}
              aria-label={`${g.open}: ${it.alt}`}
            >
              <Image
                src={it.src}
                alt={it.alt}
                widths={it.widths}
                sizes={it.sizes}
                format="webp"
                loading={i === 0 ? 'eager' : 'lazy'}
                class="h-full w-auto max-w-full object-contain"
                draggable="false"
              />
            </button>
          ))}
        </div>
        {many && (
          <>
            <button
              type="button"
              class="absolute top-1/2 left-2 hidden size-11 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-bg/80 text-fg backdrop-blur disabled:hidden pointer-fine:flex"
              aria-label={g.prev}
              data-prev
              disabled
            >
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M15 5l-7 7 7 7" />
              </svg>
            </button>
            <button
              type="button"
              class="absolute top-1/2 right-2 hidden size-11 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-bg/80 text-fg backdrop-blur disabled:hidden pointer-fine:flex"
              aria-label={g.next}
              data-next
            >
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </>
        )}
      </div>
      {many && (
        <p class="mt-3 font-mono text-sm text-muted" aria-hidden="true">
          <span data-count>1</span> / {items.length}
        </p>
      )}

      <dialog
        class="fixed inset-0 m-0 size-full max-h-none max-w-none overflow-hidden border-0 bg-transparent p-0 text-fg backdrop:bg-transparent"
        aria-label={g.viewer}
        data-viewer
      >
        <div class="absolute inset-0 bg-black" data-backdrop />
        <div class="absolute inset-0 touch-none overflow-hidden select-none" data-stage>
          <div class="flex h-full" data-strip>
            {items.map((it, i) => (
              <div class="relative h-full w-full shrink-0 overflow-hidden" data-slide>
                <img
                  alt={it.alt}
                  width={it.fullW}
                  height={it.fullH}
                  data-full={it.full}
                  data-index={i}
                  decoding="async"
                  draggable="false"
                  class="pointer-events-none size-full object-contain"
                />
              </div>
            ))}
          </div>
        </div>

        <div class="pointer-events-none absolute inset-x-0 top-0 flex items-center justify-between bg-gradient-to-b from-black/60 to-transparent pt-[env(safe-area-inset-top)] pr-[max(0.5rem,env(safe-area-inset-right))] pl-[max(1rem,env(safe-area-inset-left))]">
          <p class="font-mono text-sm text-muted" aria-live="polite">
            {many && (
              <>
                <span data-viewer-count>1</span> / {items.length}
              </>
            )}
          </p>
          <button
            type="button"
            class="pointer-events-auto flex size-11 items-center justify-center rounded-full text-fg hover:bg-white/10"
            aria-label={g.close}
            data-close
          >
            <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </div>

        {many && (
          <>
            <button
              type="button"
              class="absolute top-1/2 left-[max(0.5rem,env(safe-area-inset-left))] hidden size-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/50 text-fg hover:bg-black/70 disabled:opacity-30 pointer-fine:flex"
              aria-label={g.prev}
              data-viewer-prev
            >
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M15 5l-7 7 7 7" />
              </svg>
            </button>
            <button
              type="button"
              class="absolute top-1/2 right-[max(0.5rem,env(safe-area-inset-right))] hidden size-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/50 text-fg hover:bg-black/70 disabled:opacity-30 pointer-fine:flex"
              aria-label={g.next}
              data-viewer-next
            >
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </>
        )}

        <p class="pointer-events-none absolute inset-x-0 bottom-[max(1rem,env(safe-area-inset-bottom))] hidden text-center text-xs text-quiet pointer-coarse:block">
          {g.hint}
        </p>
      </dialog>
    </section>
  )
}

<script>
  import { initGalleries } from '../../lib/gallery';
  initGalleries();
</script>
