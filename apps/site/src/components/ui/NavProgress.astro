---
// 페이지 이동 로딩 표시(docs/01-frontend.md "로딩 상태"): 같은 사이트의 다른 페이지로 가는 링크를 누르거나 폼을 보내면
// 화면 맨 위에 가는 막대가 차오른다. 서버 렌더 페이지(어드민·사용량 등)가 늦게 올 때 눌렸는지 알 수 있게.
---

<div class="nav-progress" aria-hidden="true"></div>
<span class="nav-progress-status sr-only" role="status" aria-live="polite"></span>

<script>
  const html = document.documentElement;
  const status = document.querySelector<HTMLElement>('.nav-progress-status');
  const start = () => {
    html.classList.add('navigating');
    if (status) status.textContent = html.lang === 'en' ? 'Loading…' : '불러오는 중…';
  };
  const stop = () => {
    html.classList.remove('navigating');
    if (status) status.textContent = '';
  };
  document.addEventListener('click', (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href]');
    if (!a || a.target === '_blank' || a.hasAttribute('download')) return;
    const url = new URL(a.href, location.href);
    if (url.origin !== location.origin) return;
    // 같은 페이지 안의 앵커 이동은 로딩이 아니다
    if (url.pathname === location.pathname && url.search === location.search && url.hash) return;
    start();
  });
  document.addEventListener('submit', (e) => {
    if (!e.defaultPrevented) start();
  });
  // 뒤로 가기(bfcache)로 돌아오면 끈다
  window.addEventListener('pageshow', stop);
</script>
