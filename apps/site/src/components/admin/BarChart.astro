---
// 일별 숫자 몇 개라 라이브러리 없이 SVG로 그린다. 단일 계열 — 범례 없음, 값은 툴팁과 표로.
interface Props {
  title: string;
  unit: string;
  data: { day: string; value: number }[];
}

const { title, unit, data } = Astro.props;
const W = 320;
const H = 150;
const pad = { top: 18, right: 4, bottom: 22, left: 24 };
const plotW = W - pad.left - pad.right;
const plotH = H - pad.top - pad.bottom;
const max = Math.max(1, ...data.map((d) => d.value));
const slot = plotW / data.length;
const barW = Math.min(28, slot - 2); // 막대 사이 2px 이상
const r = Math.min(4, barW / 2);
const baseline = pad.top + plotH;

/** 위쪽 모서리만 둥글고 바닥은 기준선에 붙은 막대 */
function barPath(x: number, h: number) {
  if (h <= 0) return '';
  const rr = Math.min(r, h);
  const y = baseline - h;
  return `M${x},${baseline}V${y + rr}Q${x},${y} ${x + rr},${y}H${x + barW - rr}Q${x + barW},${y} ${x + barW},${y + rr}V${baseline}Z`;
}
const total = data.reduce((s, d) => s + d.value, 0);
---

<figure class="rounded-[var(--radius)] border border-border bg-surface p-4">
  <figcaption class="flex items-baseline justify-between gap-2">
    <span class="font-semibold">{title}</span>
    <span class="text-sm text-muted">최근 {data.length}일 합계 {total}{unit}</span>
  </figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} class="mt-3 block h-auto w-full" role="img" aria-label={`${title}: ${data.map((d) => `${d.day} ${d.value}`).join(', ')}`}>
    <line x1={pad.left} x2={W - pad.right} y1={pad.top} y2={pad.top} stroke="var(--color-border)" stroke-dasharray="2 3" />
    <text x={pad.left - 4} y={pad.top + 3} text-anchor="end" font-size="9" fill="var(--color-muted)">{max}</text>
    <line x1={pad.left} x2={W - pad.right} y1={baseline} y2={baseline} stroke="var(--color-border)" />
    <text x={pad.left - 4} y={baseline + 3} text-anchor="end" font-size="9" fill="var(--color-muted)">0</text>
    {
      data.map((d, i) => {
        const x = pad.left + i * slot + (slot - barW) / 2;
        const h = (d.value / max) * plotH;
        return (
          <g class="bar">
            <title>{`${d.day} · ${d.value}${unit}`}</title>
            {/* 막대보다 넓은 히트 영역 */}
            <rect x={pad.left + i * slot} y={pad.top} width={slot} height={plotH} fill="transparent" />
            <path d={barPath(x, h)} fill="var(--color-fg)" opacity="0.8" />
            <text x={x + barW / 2} y={H - 6} text-anchor="middle" font-size="9" fill="var(--color-muted)">
              {d.day.slice(5)}
            </text>
          </g>
        );
      })
    }
  </svg>
  <details class="mt-2 text-sm">
    <summary class="flex min-h-11 cursor-pointer items-center text-muted">표로 보기</summary>
    <table class="w-full text-left">
      <thead><tr class="text-muted"><th class="py-1 font-normal">날짜</th><th class="py-1 text-right font-normal">{unit}</th></tr></thead>
      <tbody>
        {data.map((d) => <tr class="border-t border-border"><td class="py-1">{d.day}</td><td class="py-1 text-right tabular-nums">{d.value}</td></tr>)}
      </tbody>
    </table>
  </details>
</figure>

<style>
  .bar:hover path {
    opacity: 1;
  }
</style>
