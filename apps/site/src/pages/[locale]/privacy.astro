---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const ko = locale === 'ko';
// 초안: 문구는 공개 전에 다시 확인한다. 연락처는 사이트의 레터 기능.
---

<BaseLayout
  locale={locale}
  title={ko ? '개인정보처리방침' : 'Privacy'}
  description={
    ko
      ? '레터·AI 상담에서 받는 정보(레터 내용·답장 메일·질문·IP 해시), 쓰는 목적, 보관 기간, 삭제 요청 방법과 처리 위탁(Cloudflare·Resend).'
      : 'What this site collects through letters and the AI chat (message, reply-to email, questions, IP hash), why, how long it is kept, and how to have it deleted.'
  }
>
  <article class="container-page py-10 md:py-16">
    <div class="prose-body">
      {
        ko ? (
          <>
            <h1 class="text-3xl font-bold">개인정보처리방침</h1>
            <h2>수집하는 정보</h2>
            <ul>
              <li>보낸 레터의 제목·본문·답장 받을 이메일(로그인은 필요 없습니다)</li>
              <li>AI 상담에 보낸 질문(답변 본문은 저장하지 않습니다)</li>
              <li>접속 IP의 해시값 — 하루 이용 횟수 제한과 남용 방지 목적, IP 원문은 저장하지 않습니다</li>
            </ul>
            <h2>목적</h2>
            <p>레터 전달과 답장, AI 상담 품질 확인, 남용 방지에만 씁니다. 광고나 제3자 제공은 하지 않습니다.</p>
            <h2>보관 기간</h2>
            <ul>
              <li>레터: 기록으로 보관합니다</li>
              <li>AI 상담 질문 기록: 90일</li>
              <li>이용 횟수 기록(IP 해시): 하루</li>
            </ul>
            <h2>삭제 방법</h2>
            <p>보낸 레터의 삭제를 원하면 레터로 요청해 주세요. 확인 후 지웁니다.</p>
            <h2>처리 위탁</h2>
            <p>호스팅·데이터베이스는 Cloudflare, 메일 발송은 Resend를 이용합니다.</p>
            <h2>연락처</h2>
            <p>궁금한 점은 사이트의 레터로 보내주세요.</p>
          </>
        ) : (
          <>
            <h1 class="text-3xl font-bold">Privacy</h1>
            <h2>What we collect</h2>
            <ul>
              <li>The subject, message, and reply-to address of letters you send (no sign-in needed)</li>
              <li>Questions you ask the AI chat (answers are not stored)</li>
              <li>A hash of your IP address, for daily usage limits and abuse prevention — the raw IP is not stored</li>
            </ul>
            <h2>Why</h2>
            <p>Only for delivering and replying to letters, checking chat quality, and preventing abuse. No ads, no sharing with third parties.</p>
            <h2>How long</h2>
            <ul>
              <li>Letters: kept on record</li>
              <li>Chat questions: 90 days</li>
              <li>Usage counters (IP hash): one day</li>
            </ul>
            <h2>Deleting your data</h2>
            <p>To have a letter deleted, ask in a letter and I'll remove it.</p>
            <h2>Processors</h2>
            <p>Hosting and database by Cloudflare; email delivery by Resend.</p>
            <h2>Contact</h2>
            <p>Send me a letter through this site.</p>
          </>
        )
      }
    </div>
  </article>
</BaseLayout>
