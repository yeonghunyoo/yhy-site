---
// 블로그 글(docs/08-blog.md "사이트", S-017) — 요청 때 R2 blog/posts/{slug}.{locale}.json에서. 본문 HTML은 동기화가 정리한 것
// (scripts/blog/convert.mjs: 허용 태그만, style·스크립트 없음 → CSP 그대로). 엣지 캐시는 src/worker.ts
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLocale, t } from '../../../i18n';
import { getPost, localesOf } from '../../../lib/server/blog';
import { blogPostJsonLd } from '../../../lib/jsonld';

export const prerender = false;

const { locale, slug = '' } = Astro.params;
if (!isLocale(locale)) return Astro.rewrite('/404');
const post = await getPost(slug, locale);
if (!post) return Astro.rewrite('/404');
const dict = t(locale);
const { meta, html } = post; // toc는 쓰지 않는다(S-020: 목차 없이 글에 집중)
const available = await localesOf(slug);
const fmt = new Intl.DateTimeFormat(locale === 'ko' ? 'ko-KR' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const updated = meta.updated.slice(0, 10);
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.summary}
  type="article"
  available={available}
  noindex={meta.unlisted}
  image={meta.cover ? { ...meta.cover, alt: meta.title } : undefined}
  jsonLd={blogPostJsonLd(Astro.site!, meta)}
>
  <!-- 글 화면(11/10, S-020 — Vercel 블로그식): 경로 → 제목 → 좁은 본문 한 단. 사이드바·목차 없이 글에 집중.
       날짜·읽는 시간·주소 복사는 넓은 화면에서 본문 오른쪽 옆, 좁은 화면에서 제목 아래 한 줄 -->
  <article class="post container-page" data-copy={dict.blog.copy} data-copied={dict.blog.copied}>
    <div class="post-col">
      <p class="post-crumb">
        <a href={`/${locale}/blog/`}>{dict.blog.title}</a>
        {meta.tags[0] && <><span aria-hidden="true">/</span> {meta.tags[0]}</>}
      </p>
      <h1 class="post-title">{meta.title}</h1>
      <div class="post-body-wrap">
        <aside class="post-meta" aria-label={dict.blog.published}>
          <time datetime={meta.date}>{fmt.format(new Date(meta.date))}</time>
          <span>{dict.blog.minutes.replace('{n}', String(meta.minutes))}</span>
          {updated > meta.date && <span>{dict.blog.updated} <time datetime={updated}>{fmt.format(new Date(updated))}</time></span>}
          <button type="button" class="post-copylink" data-done={dict.blog.linkCopied}>{dict.blog.copyLink}</button>
        </aside>
        <div class="prose-body blog-body" set:html={html} />
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  // 자리표시 컴포넌트(docs/08-blog.md, S-019): 자리가 있을 때만, 화면 가까이 오면 src/components/blog/<이름>.ts를 불러 mount.
  // 이름은 동기화가 허용 목록으로 걸렀고, 여기서도 레포에 있는 파일만 찾는다(import.meta.glob)
  const loaders = import.meta.glob('../../../components/blog/*.ts');
  type Mod = { mount: (el: HTMLElement, props: Record<string, unknown>) => unknown };
  const mount = async (el: HTMLElement) => {
    const load = loaders[`../../../components/blog/${el.dataset.blogComponent}.ts`];
    if (!load) return;
    let props: Record<string, unknown> = {};
    try {
      props = JSON.parse(el.dataset.props || '{}');
    } catch {
      /* 빈 설정 */
    }
    try {
      await ((await load()) as Mod).mount(el, props);
    } catch (e) {
      console.error('blog component', el.dataset.blogComponent, e); // 실패하면 대체 글이 그대로
    }
  };
  // 코드(S-020): 탭 전환·복사 버튼·주소 복사. 스크립트가 없으면 탭 내용이 이름표와 함께 차례로 보인다
  const article = document.querySelector<HTMLElement>('.post');
  const copyText = async (text: string, btn: HTMLButtonElement, done: string) => {
    try {
      await navigator.clipboard.writeText(text);
      const label = btn.textContent;
      btn.textContent = done;
      setTimeout(() => (btn.textContent = label), 1500);
    } catch {
      /* 권한 없음 — 그대로 */
    }
  };
  const copyButton = (getText: () => string) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code-copy';
    btn.textContent = article?.dataset.copy ?? 'Copy';
    btn.addEventListener('click', () => void copyText(getText(), btn, article?.dataset.copied ?? 'Copied'));
    return btn;
  };
  document.querySelectorAll<HTMLElement>('.blog-body .code-tabs, .blog-body .code-file').forEach((box) => {
    const panes = [...box.querySelectorAll<HTMLElement>(':scope > .code-tab')];
    const bar = document.createElement('div');
    bar.className = 'code-bar';
    const tabs = document.createElement('div');
    tabs.className = 'code-bar-tabs';
    if (box.classList.contains('code-tabs')) tabs.setAttribute('role', 'tablist');
    bar.appendChild(tabs);
    const show = (i: number) =>
      panes.forEach((p, j) => {
        p.hidden = j !== i;
        tabs.children[j]?.setAttribute('aria-selected', String(j === i));
      });
    panes.forEach((pane, i) => {
      const label = pane.dataset.label ?? '';
      if (box.classList.contains('code-tabs')) {
        const b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('role', 'tab');
        b.textContent = label;
        b.addEventListener('click', () => show(i));
        tabs.appendChild(b);
      } else {
        const name = document.createElement('span');
        name.textContent = label;
        tabs.appendChild(name);
      }
      pane.querySelector('.code-label')?.remove();
    });
    // 복사 버튼은 지금 보이는 탭의 코드를 복사한다
    bar.appendChild(copyButton(() => panes.find((p) => !p.hidden)?.querySelector('code')?.textContent ?? ''));
    box.insertBefore(bar, box.firstChild);
    box.classList.add('is-live');
    show(0);
  });
  // 이름표 없는 코드 블록: 오른쪽 위에 복사 버튼
  document.querySelectorAll<HTMLElement>('.blog-body pre').forEach((pre) => {
    if (pre.closest('.code-tabs, .code-file')) return;
    const wrap = document.createElement('div');
    wrap.className = 'code-plain';
    pre.parentElement?.insertBefore(wrap, pre);
    wrap.appendChild(pre);
    wrap.appendChild(copyButton(() => pre.querySelector('code')?.textContent ?? ''));
  });
  document.querySelector<HTMLButtonElement>('.post-copylink')?.addEventListener('click', (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    void copyText(location.href.split('#')[0], btn, btn.dataset.done ?? 'Copied');
  });

  const els = document.querySelectorAll<HTMLElement>('[data-blog-component]');
  if (els.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          void mount(e.target as HTMLElement);
        }
      },
      { rootMargin: '300px 0px' },
    );
    els.forEach((el) => io.observe(el));
  }
</script>
