---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, t, type Locale } from '../../i18n';
import { getProjects } from '../../lib/projects';
import { career, formatMonths } from '../../data/career';
import { stack } from '../../data/stack';
import { Image } from 'astro:assets';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dict = t(locale);
const h = dict.home;
const hero = h.hero;
const projects = await getProjects(locale);
const { jobs, total } = career(locale);
const recent = [...jobs].reverse();
const groups = stack(locale);
---

<BaseLayout locale={locale}>
  <!--
    홈(11/05, decisions S-009): 3D 픽셀 히어로 → 본문이 위로 덮는 패럴랙스 커튼 → 정리된 본문.
    히어로 연출은 src/lib/hero/hero.ts(스크롤) + scene.js(three.js, 동적 import). 글은 모두 HTML에 있다(검색·AI·스크립트 없음)
  -->
  <div class="story" data-hero>
    <div class="story-stage">
      <img class="story-poster" src="/hero/poster.webp" alt="" width="80" height="45" decoding="async" />
      <canvas class="story-canvas" aria-hidden="true"></canvas>
      <div class="story-shade" aria-hidden="true"></div>
      <h1 class="sr-only">{hero.title}</h1>
      <p class="story-cap on" data-side="l" data-from="0" data-to="0.2"><span>// {hero.k1}</span><b>{hero.l1}</b></p>
      <p class="story-cap" data-side="r" data-from="0.24" data-to="0.5"><span>// {hero.k2}</span><b>{hero.l2}</b></p>
      <p class="story-cap" data-side="l" data-from="0.6" data-to="0.86"><span>// {hero.k3}</span><b>{hero.l3}</b></p>
      <p class="story-cap story-final" data-from="0.9" data-to="1.01" lang="en"><b>BETTER CALL <em>YH!</em></b><span>{dict.contact.mail}</span></p>
    </div>
  </div>

  <!-- 본문(11/05, decisions S-010): 무채색 + 강조색 하나(구분·강조에만), 표·구분선·장식 없음. 소개 → 경력 → 스택 → 프로젝트 → 연락 -->
  <!-- 데스크톱 플로팅 목차(11/05): 화면 왼쪽 가운데, 반투명. 본문에 들어오면 나타나고 지금 섹션을 표시(src/lib/toc.ts) -->
  <nav class="home-toc" aria-label="Sections" data-toc>
    <a href="#about">About</a>
    <a href="#career">Career</a>
    <a href="#stack">Stack</a>
    <a href="#project">Projects</a>
    <a href="#contact">Contact</a>
  </nav>
  <div class="home-body">
    <div class="container-page home-in">
      <section id="about" aria-labelledby="about-heading">
        <p class="home-kick"><span>//</span> About</p>
        <h2 id="about-heading" class="home-statement">{h.statement[0]} <span>{h.statement[1]}</span></h2>
        <p class="home-lead">{h.statementLead}</p>
        <p class="home-meta">
          <span>{h.experience} <b>{formatMonths(total, locale)}</b></span>
          <span>{h.now} <b>{h.nowAt}</b></span>
          <a href="https://github.com/yeonghunyoo" rel="noopener" class="home-gh" aria-label="GitHub — yeonghunyoo" title="github.com/yeonghunyoo">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          </a>
        </p>
      </section>

      <section id="career" aria-labelledby="career-heading">
        <h2 id="career-heading" class="home-kick"><span>//</span> Career <small>{formatMonths(total, locale)}</small></h2>
        <ol class="home-path">
          {
            recent.map((j) => (
              <li class:list={{ now: j.current }}>
                {j.name}
                {j.note && <span>{j.note}</span>}
                <span class="len">
                  {j.current && `${h.current} · `}
                  {formatMonths(j.months, locale)}
                </span>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="stack" aria-labelledby="stack-heading" class="home-stack">
        <h2 id="stack-heading" class="home-kick"><span>//</span> Stack</h2>
        {
          groups.map((g) => (
            <div>
              <h3>{g.title}</h3>
              <ul class="home-tags">
                {g.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section id="project" aria-labelledby="project-heading">
        <h2 id="project-heading" class="home-kick"><span>//</span> Projects <small>{projects.length}</small></h2>
        <ol class="home-works" data-focus-list>
          {
            projects.map((p) => (
              <li>
                <a class="home-work" href={`/${locale}/projects/${p.slug}/`}>
                  {/* 썸네일(11/05): 상세 갤러리 첫 장. 없으면 같은 크기의 빈 칸 — 나중에 이미지만 넣으면 채워진다.
                      호버하면 원래 비율로 커진다(src/lib/thumb-peek.ts) */}
                  <span class="thumb" aria-hidden="true" data-peek={p.data.images[0] ? `${p.data.images[0].src.width}x${p.data.images[0].src.height}` : undefined}>
                    {p.data.images[0] && (
                      <span class="thumb-pop">
                        <Image src={p.data.images[0].src} alt="" widths={[320, 640, 1280]} sizes="(min-width: 768px) 15rem, 100vw" format="webp" loading="lazy" />
                      </span>
                    )}
                  </span>
                  <span class="body">
                    {p.data.period && <span class="when">{p.data.period}</span>}
                    <span class="name">{p.data.title}</span>
                    <span class="one">{p.data.short ?? p.data.summary}</span>
                    {p.data.stack && <span class="tech">{p.data.stack.join(' · ')}</span>}
                    {/* 화면 가운데에 온 프로젝트만 펼쳐 보이는 설명(11/05, src/lib/focus-list.ts). 스크립트가 없으면 늘 보인다 */}
                    <span class="more"><span>{p.data.summary}</span></span>
                  </span>
                  {p.data.metric && (
                    <span class="num">
                      <b>
                        {p.data.metric.value}
                        {p.data.metric.unit}
                      </b>
                      <span>{p.data.metric.label}</span>
                    </span>
                  )}
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="contact" aria-labelledby="contact-heading" class="home-ask">
        <p class="home-kick"><span>//</span> Contact</p>
        <h2 id="contact-heading" class="home-big">{h.askTitle}</h2>
        <p class="home-lead">{h.askNote}</p>
        {/* 레터 버튼(11/05): 호버하면 강조색이 픽셀 계단처럼 왼쪽에서 차오르고 화살표 칸이 뒤집힌다 */}
        <button type="button" class="home-btn" data-action="letter">
          <span>{dict.contact.letter}</span>
          <span class="home-btn-go" aria-hidden="true">→</span>
        </button>
        <p class="home-meta"><span>{h.or} <b>{dict.contact.mail}</b></span></p>
      </section>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* 히어로(클래스는 story-* — daisyUI의 hero·hero-content와 겹치면 레이아웃이 깨진다): 스크립트 없음·움직임 줄이기 = 짧은 정적 히어로(포스터 + 마지막 문구). hero.ts가 .is-live를 붙이면 긴 스크롤 이야기 */
  .story { position: relative; }
  .story-stage {
    position: relative; height: min(78dvh, 720px); overflow: hidden; background: var(--color-bg);
  }
  .story-poster, .story-canvas { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; }
  .story-poster { object-fit: cover; transition: opacity 0.4s; }
  .story-canvas { display: block; }
  .story-shade { position: absolute; inset: 0; background: #000; opacity: 0; pointer-events: none; }
  .story-cap {
    position: absolute; left: 0; right: 0; bottom: 14%; margin: 0; padding-inline: max(1.5rem, env(safe-area-inset-left)) max(1.5rem, env(safe-area-inset-right));
    display: flex; flex-direction: column; gap: 0.6rem; opacity: 0; transform: translateY(8px); transition: opacity 0.35s, transform 0.35s; pointer-events: none;
  }
  .story-cap span { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-muted); }
  .story-cap b { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.75rem, 5vw, 3.5rem); line-height: 1.1; text-wrap: balance; }
  /* 가독성(11/05): 문구가 보일 때만 뒤에 어두운 그늘 — 아래 문구는 아래쪽 그라데이션, 마지막 문구는 글자 뒤 원형 */
  .story-cap { z-index: 1; }
  .story-cap::before { content: ""; position: absolute; z-index: -1; left: 0; right: 0; top: -45vh; bottom: -20vh; background: linear-gradient(to top, rgb(14 15 17 / 0.92) 30%, rgb(14 15 17 / 0)); pointer-events: none; }
  .story-final::before { inset: -30% -10%; background: radial-gradient(closest-side, rgb(14 15 17 / 0.85), rgb(14 15 17 / 0)); }
  .story-cap b, .story-cap span { text-shadow: 0 1px 12px rgb(0 0 0 / 0.8); }
  .story-cap.on { opacity: 1; transform: none; }
  .story-final { top: 50%; bottom: auto; transform: translateY(-50%); align-items: center; text-align: center; }
  .story-final.on { transform: translateY(-50%); }
  .story-final b { font-size: clamp(2.75rem, 10vw, 7.5rem); text-shadow: 0 0 24px var(--color-bg); }
  .story-final em { font-style: normal; color: var(--color-accent); }
  /* 데스크톱(11/05): 문구를 화면 세로 가운데, 왼쪽·오른쪽 번갈아. 그늘도 그쪽 옆으로 */
  @media (min-width: 768px) {
    /* 가장자리가 아니라 가운데 쪽으로 당겨(11/05): 바깥 여백을 화면 폭의 12% */
    .story-cap[data-side] { top: 50%; bottom: auto; width: min(40%, 32rem); padding-inline: 0; transform: translateY(calc(-50% + 8px)); }
    .story-cap[data-side].on { transform: translateY(-50%); }
    .story-cap[data-side='l'] { left: 12vw; right: auto; }
    .story-cap[data-side='r'] { left: auto; right: 12vw; align-items: flex-end; text-align: right; }
    .story-cap[data-side]::before { top: -50vh; bottom: -50vh; }
    .story-cap[data-side='l']::before { left: -12vw; right: -40%; background: linear-gradient(to right, rgb(14 15 17 / 0.9) 45%, rgb(14 15 17 / 0)); }
    .story-cap[data-side='r']::before { left: -40%; right: -12vw; background: linear-gradient(to left, rgb(14 15 17 / 0.9) 45%, rgb(14 15 17 / 0)); }
  }
  /* 정적 히어로: 첫 문구 대신 마지막 문구 */
  .story:not(.is-live) .story-cap { opacity: 0; }
  .story:not(.is-live) .story-final { opacity: 1; }

  /* 이야기: 화면 100vh + 히어로 252vh + 머묾 100vh(마지막 문장, 픽셀이 가운데로 사라짐) + 커튼 100vh(hero.ts와 맞춘다) */
  .story.is-live { height: 552vh; }
  .story.is-live .story-stage { position: sticky; top: 0; height: 100vh; height: 100dvh; will-change: transform; }
  .story.is-live .story-shade { will-change: opacity; }
  .story.is-3d .story-poster { opacity: 0; }
  .story.is-live + .home-body { margin-top: -100vh; }

  /* 본문: 커튼처럼 히어로 위로 올라온다. 무채색 + 강조색 하나, 장식 없음(S-010) */
  .home-body {
    position: relative; z-index: 2; background: var(--color-bg); box-shadow: 0 -16px 40px rgb(0 0 0 / 0.35); padding-block: 5rem 7rem;
  }
  .home-in { max-width: 1040px; display: flex; flex-direction: column; gap: clamp(5.5rem, 12vw, 9rem); }
  /* 섹션 제목(11/05): 영어, 크게. // 는 흐리게, 옆 숫자(경력·개수)는 작게 */
  .home-kick { margin: 0 0 2rem; display: flex; align-items: baseline; gap: 0.6rem; font-family: var(--font-display); font-size: clamp(1.25rem, 1.8vw, 1.5rem); font-weight: 700; color: var(--color-fg); letter-spacing: 0.01em; }
  .home-kick > span { color: var(--color-quiet); }
  .home-kick small { font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 400; color: var(--color-muted); }
  .home-gh { display: inline-grid; place-items: center; width: 1.75rem; height: 1.75rem; border: 0 !important; color: var(--color-fg); transition: color 0.15s, scale 0.15s; }
  .home-gh svg { width: 1.25rem; height: 1.25rem; }
  .home-gh:hover { color: var(--color-accent); }
  .home-gh:active { scale: 0.92; }
  .home-statement { margin: 0; max-width: 22ch; font-size: clamp(1.75rem, 4.4vw, 3.25rem); line-height: 1.32; font-weight: 500; letter-spacing: -0.015em; text-wrap: balance; }
  .home-statement span { color: var(--color-muted); }
  .home-lead { margin: 1.75rem 0 0; max-width: 46ch; color: var(--color-muted); font-size: 1rem; line-height: 1.8; }
  .home-meta { margin: 2rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.375rem; font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-muted); }
  .home-meta b { color: var(--color-fg); font-weight: 500; }
  .home-meta a { color: var(--color-fg); border-bottom: 1px solid var(--color-border); }
  .home-meta a:hover { color: var(--color-accent); border-color: var(--color-accent); }
  .home-path { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.125rem; }
  .home-path li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.875rem; font-size: clamp(1.25rem, 2.6vw, 1.75rem); font-weight: 500; }
  .home-path li span { font-size: 0.875rem; font-weight: 400; color: var(--color-muted); }
  .home-path li .len { margin-left: auto; font-family: var(--font-mono); font-size: 0.8125rem; }
  .home-path li.now .len { color: var(--color-accent); }
  .home-stack { display: flex; flex-direction: column; gap: 1.75rem; }
  .home-stack .home-kick { margin-bottom: 0; }
  .home-stack h3 { margin: 0 0 0.75rem; font-size: 0.875rem; font-weight: 500; color: var(--color-muted); }
  .home-tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.375rem 1rem; font-family: var(--font-mono); font-size: 0.875rem; }
  .home-works { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: clamp(3.5rem, 8vw, 5.5rem); }
  .home-work { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.25rem 2.5rem; }
  .home-work .thumb { position: relative; flex: 1 1 100%; aspect-ratio: 16 / 10; border-radius: 14px; background: var(--color-surface); }
  /* 호버 확대(11/05, thumb-peek.ts): 칸은 자리를 그대로 두고, 안의 .thumb-pop만 원래 비율로 커져 위에 뜬다 */
  .home-work .thumb-pop {
    position: absolute; left: 0; top: 0; width: 100%; height: 100%; border-radius: 14px; overflow: hidden; background: var(--color-surface);
    transition: left 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), top 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), width 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), height 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s;
  }
  .home-work .thumb.is-pop .thumb-pop { box-shadow: var(--shadow-pop); }
  .home-works > li { position: relative; }
  .home-works > li.is-pop { z-index: 5; }
  .home-work .thumb img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; transition: transform 0.4s; }
  .home-work:hover .thumb img { transform: scale(1.03); }
  .home-work .body { flex: 999 1 26rem; min-width: 0; display: flex; flex-direction: column; gap: 0.625rem; }
  .home-work .when, .home-work .tech { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-muted); }
  .home-work .name { font-family: var(--font-display); font-weight: 700; font-size: clamp(2.5rem, 5.4vw, 4rem); line-height: 1; overflow-wrap: anywhere; }
  /* 화살표는 자리를 차지하지 않게(긴 이름 뒤에서 줄이 바뀌어 빈 줄이 생기지 않게) */
  .home-work .name { position: relative; }
  .home-work .name::after { content: '→'; position: absolute; margin-left: 0.4em; font-size: 0.5em; line-height: 2; color: var(--color-accent); opacity: 0; transform: translateX(-0.5rem); transition: opacity 0.2s, transform 0.2s; }
  .home-work:hover .name::after, .home-work:focus-visible .name::after { opacity: 1; transform: none; }
  .home-work:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 0.5rem; }
  .home-work .one { font-size: 1.0625rem; }
  .home-work .num { flex: 1 1 11rem; display: flex; flex-direction: column; align-items: flex-start; gap: 0.25rem; }
  .home-work .num b { font-family: var(--font-mono); font-weight: 500; font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1; color: var(--color-accent); font-variant-numeric: tabular-nums; }
  .home-work .num span { font-size: 0.8125rem; color: var(--color-muted); max-width: 22ch; }
  /* 스크롤 포커스(11/05): 화면 가운데 띠에 온 항목만 선명하게, 설명을 펼친다. focus-list.ts가 .is-focus-mode·.is-focus를 붙인다 */
  .home-work .more { color: var(--color-muted); font-size: 0.9375rem; line-height: 1.7; max-width: 52ch; }
  .is-focus-mode > li { opacity: 0.35; transition: opacity 0.45s; }
  .is-focus-mode > li.is-focus { opacity: 1; }
  /* 설명은 자리를 늘 차지하고 투명도만 바꾼다 — 높이를 접었다 펴면 스크롤하는 동안 글이 위아래로 밀린다(11/05) */
  .is-focus-mode .home-work .more { opacity: 0; transition: opacity 0.35s; }
  .is-focus-mode .is-focus .home-work .more { opacity: 1; }
  .is-focus-mode .is-focus .home-work .name::after { opacity: 1; transform: none; }
  .is-focus-mode .is-focus .home-work .thumb img { transform: scale(1.03); }
  .home-works .home-work .thumb.is-pop img { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .is-focus-mode > li, .is-focus-mode .home-work .more, .home-work .thumb-pop { transition: none; }
  }
  .home-toc { display: none; }
  @media (min-width: 1200px) {
    .home-toc {
      position: fixed; z-index: 20; left: 1.25rem; top: 50%; translate: -0.5rem -50%; display: flex; flex-direction: column; gap: 0.125rem;
      padding: 0.5rem; border-radius: 14px; background: rgb(32 35 39 / 0.55); backdrop-filter: blur(10px);
      font-family: var(--font-mono); font-size: 0.75rem; opacity: 0; pointer-events: none; transition: opacity 0.3s, translate 0.3s;
    }
    .home-toc.is-on { opacity: 1; translate: 0 -50%; pointer-events: auto; }
    .home-toc a { display: flex; align-items: center; gap: 0.5rem; min-height: 2rem; padding: 0 0.625rem; border-radius: 8px; color: var(--color-quiet); transition: color 0.15s, background-color 0.15s; }
    .home-toc a::before { content: ''; width: 0.375rem; height: 0.375rem; border-radius: 1px; background: currentColor; opacity: 0.5; }
    .home-toc a:hover { color: var(--color-fg); background: rgb(255 255 255 / 0.05); }
    .home-toc a[aria-current='true'] { color: var(--color-fg); }
    .home-toc a[aria-current='true']::before { background: var(--color-accent); opacity: 1; }
    .home-toc a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  }
  @media (prefers-reduced-motion: reduce) { .home-toc { transition: none; } }
  .home-ask { display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; }
