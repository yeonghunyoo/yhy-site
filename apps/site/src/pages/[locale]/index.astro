---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, t, type Locale } from '../../i18n';
import { getProjects } from '../../lib/projects';
import { career, formatMonths } from '../../data/career';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dict = t(locale);
const h = dict.home;
const hero = h.hero;
const projects = await getProjects(locale);
const { jobs, total } = career(locale);
const recent = [...jobs].reverse();
---

<BaseLayout locale={locale}>
  <!--
    홈(11/05, decisions S-009): 3D 픽셀 히어로 → 본문이 위로 덮는 패럴랙스 커튼 → 정리된 본문.
    히어로 연출은 src/lib/hero/hero.ts(스크롤) + scene.js(three.js, 동적 import). 글은 모두 HTML에 있다(검색·AI·스크립트 없음)
  -->
  <div class="story" data-hero>
    <div class="story-stage">
      <img class="story-poster" src="/hero/poster.webp" alt="" width="80" height="45" decoding="async" />
      <canvas class="story-canvas" aria-hidden="true"></canvas>
      <div class="story-shade" aria-hidden="true"></div>
      <h1 class="sr-only">{hero.title}</h1>
      <p class="story-cap on" data-from="0" data-to="0.2"><span>// {hero.k1}</span><b>{hero.l1}</b></p>
      <p class="story-cap" data-from="0.24" data-to="0.5"><span>// {hero.k2}</span><b>{hero.l2}</b></p>
      <p class="story-cap" data-from="0.6" data-to="0.86"><span>// {hero.k3}</span><b>{hero.l3}</b></p>
      <p class="story-cap story-final" data-from="0.9" data-to="1.01" lang="en"><b>BETTER CALL <em>YH!</em></b><span>{dict.contact.mail}</span></p>
    </div>
  </div>

  <div class="home-body">
    <section id="about" class="container-page home-sec" aria-labelledby="about-heading">
      <p class="home-kicker">// {dict.intro.name}</p>
      <h2 id="about-heading" class="home-h2">{h.role}</h2>
      <p class="home-lead">{h.about}</p>
      <dl class="home-facts">
        <div><dt>{h.experience}</dt><dd class="num">{formatMonths(total, locale)}</dd></div>
        <div><dt>{h.now}</dt><dd>{h.nowAt}</dd></div>
        <div><dt>GitHub</dt><dd><a href="https://github.com/yeonghunyoo" rel="noopener">{h.github} ↗</a></dd></div>
        <div><dt>{dict.contact.heading}</dt><dd><a href="#contact">{dict.contact.mail}</a></dd></div>
      </dl>
    </section>

    <section id="project" class="container-page home-sec" aria-labelledby="project-heading">
      <h2 id="project-heading" class="home-h2">{dict.nav.project}<small>{projects.length}</small></h2>
      <ol class="home-rows">
        {
          projects.map((p, i) => (
            <li>
              <a href={`/${locale}/projects/${p.slug}/`} class="home-row">
                <span class="n">{String(i + 1).padStart(2, '0')}</span>
                <span class="main">
                  <span class="t">{p.data.title}</span>
                  <span class="d">{p.data.short ?? p.data.summary}</span>
                </span>
                <span class="period">{p.data.period}</span>
                <span class="metric">
                  {p.data.metric && (
                    <>
                      <b>
                        {p.data.metric.value}
                        {p.data.metric.unit}
                      </b>{' '}
                      {p.data.metric.label}
                    </>
                  )}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="career" class="container-page home-sec" aria-labelledby="career-heading">
      <h2 id="career-heading" class="home-h2">{dict.nav.career}<small>{h.total} {formatMonths(total, locale)}</small></h2>
      <ol class="home-rows">
        {
          recent.map((j) => (
            <li class="home-row">
              <span class="n">{j.current ? '●' : ''}</span>
              <span class="main">
                <span class="t">{j.name}</span>
                {j.note && <span class="d">{j.note}</span>}
              </span>
              <span class="period" />
              <span class="metric">
                {j.current && <b>{h.current} · </b>}
                {formatMonths(j.months, locale)}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="contact" class="container-page home-sec home-contact" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="home-h2">{dict.contact.heading}</h2>
      <p class="home-lead">{h.letterNote}</p>
      <p class="home-cta">
        <button type="button" class="btn btn-primary" data-action="letter">{dict.contact.letter} →</button>
        <span class="home-kicker">{dict.contact.mail}</span>
      </p>
    </section>
  </div>
</BaseLayout>

<style is:global>
  /* 히어로(클래스는 story-* — daisyUI의 hero·hero-content와 겹치면 레이아웃이 깨진다): 스크립트 없음·움직임 줄이기 = 짧은 정적 히어로(포스터 + 마지막 문구). hero.ts가 .is-live를 붙이면 긴 스크롤 이야기 */
  .story { position: relative; }
  .story-stage {
    position: relative; height: min(78dvh, 720px); overflow: hidden; background: var(--color-bg);
  }
  .story-poster, .story-canvas { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; }
  .story-poster { object-fit: cover; transition: opacity 0.4s; }
  .story-canvas { display: block; }
  .story-shade { position: absolute; inset: 0; background: #000; opacity: 0; pointer-events: none; }
  .story-cap {
    position: absolute; left: 0; right: 0; bottom: 14%; margin: 0; padding-inline: max(1.5rem, env(safe-area-inset-left)) max(1.5rem, env(safe-area-inset-right));
    display: flex; flex-direction: column; gap: 0.6rem; opacity: 0; transform: translateY(8px); transition: opacity 0.35s, transform 0.35s; pointer-events: none;
  }
  .story-cap span { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-muted); }
  .story-cap b { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.75rem, 5vw, 3.5rem); line-height: 1.1; text-wrap: balance; }
  /* 가독성(11/05): 문구가 보일 때만 뒤에 어두운 그늘 — 아래 문구는 아래쪽 그라데이션, 마지막 문구는 글자 뒤 원형 */
  .story-cap { z-index: 1; }
  .story-cap::before { content: ""; position: absolute; z-index: -1; left: 0; right: 0; top: -45vh; bottom: -20vh; background: linear-gradient(to top, rgb(14 15 17 / 0.92) 30%, rgb(14 15 17 / 0)); pointer-events: none; }
  .story-final::before { inset: -30% -10%; background: radial-gradient(closest-side, rgb(14 15 17 / 0.85), rgb(14 15 17 / 0)); }
  .story-cap b, .story-cap span { text-shadow: 0 1px 12px rgb(0 0 0 / 0.8); }
  .story-cap.on { opacity: 1; transform: none; }
  .story-final { top: 50%; bottom: auto; transform: translateY(-50%); align-items: center; text-align: center; }
  .story-final.on { transform: translateY(-50%); }
  .story-final b { font-size: clamp(2.75rem, 10vw, 7.5rem); text-shadow: 0 0 24px var(--color-bg); }
  .story-final em { font-style: normal; color: var(--color-accent); }
  /* 정적 히어로: 첫 문구 대신 마지막 문구 */
  .story:not(.is-live) .story-cap { opacity: 0; }
  .story:not(.is-live) .story-final { opacity: 1; }

  /* 이야기: 화면 100vh + 히어로 252vh + 커튼 100vh(hero.ts의 HERO_VH와 맞춘다) */
  .story.is-live { height: 452vh; }
  .story.is-live .story-stage { position: sticky; top: 0; height: 100vh; height: 100dvh; will-change: transform; }
  .story.is-live .story-shade { will-change: opacity; }
  .story.is-3d .story-poster { opacity: 0; }
  .story.is-live + .home-body { margin-top: -100vh; }

  /* 본문: 커튼처럼 히어로 위로 올라온다 */
  .home-body {
    position: relative; z-index: 2; background: var(--color-bg); border-top: 1px solid var(--color-border);
    box-shadow: 0 -24px 48px rgb(0 0 0 / 0.6); padding-block: 3rem 5rem;
  }
  .home-sec { padding-block: 2.5rem; display: flex; flex-direction: column; gap: 1.25rem; }
  .home-kicker { margin: 0; font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-muted); }
  .home-h2 { margin: 0; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.75rem; font-family: var(--font-display); font-weight: 400; font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.15; }
  .home-h2 small { font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-accent); }
  .home-lead { margin: 0; max-width: 62ch; color: var(--color-muted); font-size: 1rem; line-height: 1.75; }
  .home-facts { margin: 0.5rem 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface); }
  .home-facts div { padding: 0.875rem 1rem; display: flex; flex-direction: column; gap: 0.15rem; border-bottom: 1px solid var(--color-border); min-width: 0; }
  .home-facts div:nth-child(odd) { border-right: 1px solid var(--color-border); }
  .home-facts div:nth-last-child(-n + 2) { border-bottom: 0; }
  .home-facts dt { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-quiet); }
  .home-facts dd { margin: 0; overflow-wrap: anywhere; }
  .home-facts a:hover { color: var(--color-accent); }
  .home-rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border); }
  .home-row {
    display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); column-gap: 0.75rem; row-gap: 0.25rem; align-items: baseline;
    padding-block: 1.1rem; border-bottom: 1px solid var(--color-border);
  }
  a.home-row:hover .t, a.home-row:focus-visible .t { color: var(--color-accent); }
  .home-row .n { grid-row: span 3; font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-quiet); }
  .home-row .main { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .home-row .t { font-size: 1.125rem; font-weight: 600; }
  .home-row .d { color: var(--color-muted); font-size: 0.875rem; }
  .home-row .period, .home-row .metric { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .home-row .metric b { color: var(--color-accent); font-weight: 500; }
  .home-cta { margin: 0.5rem 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; }
  @media (min-width: 768px) {
    .home-sec { padding-block: 3.5rem; }
    .home-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .home-facts div { border-bottom: 0; border-right: 1px solid var(--color-border); }
    .home-facts div:last-child { border-right: 0; }
    .home-row { grid-template-columns: 3rem minmax(0, 1fr) 7rem minmax(9rem, 14rem); column-gap: 1.5rem; }
    .home-row .n { grid-row: auto; }
    .home-row .metric { text-align: right; }
  }
</style>

<script>
  import { initHero } from '../../lib/hero/hero';
  initHero();
</script>
