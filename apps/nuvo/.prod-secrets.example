# 운영 비밀값 템플릿. 복사해서 .prod-secrets.local 로 만든 뒤 값을 채운다 (git 제외 파일).
#   cp .prod-secrets.example .prod-secrets.local && chmod 600 .prod-secrets.local
# 배포: pnpm build && pnpm exec wrangler deploy --secrets-file .prod-secrets.local
# 자세한 순서: docs/developer-guide.md 9단계
BETTER_AUTH_SECRET=
MEDIA_SIGNING_KEY=
# 운영자 관리 경로용 (32자 이상 무작위). 같은 값을 git 제외 파일 .admin-token.local 에도 둔다. 비우면 관리 경로가 꺼진다
ADMIN_TOKEN=
BETTER_AUTH_URL=https://nuvo.example.com
# 메일 (Resend) — 이메일 로그인에 필요. 비어 있으면 운영에서 이메일 로그인이 꺼진다
RESEND_API_KEY=
EMAIL_FROM=nuvo <noreply@mail.example.com>
# 소셜 로그인 (12·13단계)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
