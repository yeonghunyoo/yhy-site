---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, t, type Locale } from '../../i18n';
import { getProjects } from '../../lib/projects';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dict = t(locale);
const projects = await getProjects(locale);
---

<BaseLayout locale={locale}>
  <section
    id="intro"
    class="relative grid min-h-[calc(100dvh-var(--header-h)-env(safe-area-inset-top))] place-items-center overflow-hidden"
  >
    <!-- 3D 배경 아일랜드 자리 (7단계, 옵션) -->
    <div class="container-page py-16">
      <h1 class="text-[clamp(2.5rem,12vw,6rem)] leading-none font-bold tracking-tight">{dict.intro.name}</h1>
      <p class="mt-6 max-w-[32ch] text-[clamp(1.125rem,4.5vw,1.5rem)] text-muted">{dict.intro.tagline}</p>
    </div>
  </section>

  <section id="project" class="container-page py-16 md:py-24" aria-labelledby="project-heading">
    <h2 id="project-heading" class="text-2xl font-bold md:text-3xl">{dict.project.heading}</h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-2">
      {
        projects.map((project) => (
          <li class="flex flex-col rounded-[var(--radius)] border border-border bg-surface p-5 md:p-6">
            <h3 class="text-xl font-bold">{project.data.title}</h3>
            <p class="mt-3 text-muted">{project.data.summary}</p>
            <ul class="mt-4 flex flex-wrap gap-2" aria-label={dict.project.stack}>
              {project.data.stack.map((s) => (
                <li class="rounded-full border border-border px-3 py-1 text-sm">{s}</li>
              ))}
            </ul>
            <a href={`/${locale}/projects/${project.slug}/`} class="btn mt-6 self-start">
              {dict.project.more}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="contact" class="container-page py-16 md:py-24" aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="text-2xl font-bold md:text-3xl">{dict.contact.heading}</h2>
    <p class="prose-body mt-4 text-muted">{dict.contact.body}</p>
    <button type="button" class="btn btn-primary mt-8" data-action="letter">{dict.contact.letter}</button>
  </section>
</BaseLayout>
