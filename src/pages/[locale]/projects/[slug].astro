---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, t, type Locale } from '../../../i18n';
import { getProjects } from '../../../lib/projects';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    for (const project of await getProjects(locale)) {
      paths.push({ params: { locale, slug: project.slug }, props: { project } });
    }
  }
  return paths;
}

const { project } = Astro.props;
const locale = Astro.params.locale as Locale;
const dict = t(locale);
const { Content } = await render(project);
---

<BaseLayout locale={locale} title={project.data.title} description={project.data.summary}>
  <article class="container-page py-10 md:py-16">
    <a href={`/${locale}/#project`} class="-ml-2 inline-flex min-h-11 items-center px-2 text-sm text-muted"
      >{dict.project.back}</a
    >
    <h1 class="mt-4 text-3xl font-bold md:text-5xl">{project.data.title}</h1>
    <p class="prose-body mt-4 text-lg text-muted">{project.data.summary}</p>

    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,65ch)_1fr]">
      <div class="prose-body">
        <Content />
      </div>

      <aside class="space-y-10">
        <section aria-labelledby="stack-heading">
          <h2 id="stack-heading" class="text-lg font-bold">{dict.project.stack}</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {project.data.stack.map((s) => <li class="rounded-full border border-border px-3 py-1 text-sm">{s}</li>)}
          </ul>
        </section>
        <section aria-labelledby="changelog-heading">
          <h2 id="changelog-heading" class="text-lg font-bold">{dict.project.changelog}</h2>
          <ol class="mt-3 space-y-3 border-l border-border pl-4">
            {
              project.data.changelog.map((c) => (
                <li>
                  <time datetime={c.date} class="block font-mono text-sm text-muted">
                    {c.date}
                  </time>
                  <span>{c.text}</span>
                </li>
              ))
            }
          </ol>
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>
