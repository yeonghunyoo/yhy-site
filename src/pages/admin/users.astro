---
import { desc, max } from 'drizzle-orm';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { account, session, user } from '../../db/schema';
import { getDb } from '../../lib/server/db';
import { formatKst } from '../../lib/server/dates';

export const prerender = false;

const db = getDb();
const users = await db.select().from(user).orderBy(desc(user.createdAt)).limit(200);
const providers = await db.select({ userId: account.userId, providerId: account.providerId }).from(account);
const lastSeen = await db.select({ userId: session.userId, at: max(session.createdAt) }).from(session).groupBy(session.userId);

const methodOf = (id: string) => (providers.some((p) => p.userId === id && p.providerId === 'google') ? 'Google' : '이메일 링크');
const lastOf = (id: string) => lastSeen.find((s) => s.userId === id)?.at ?? null;
const me = Astro.locals.user?.id;
---

<AdminLayout title="사용자">
  <h1 class="text-2xl font-bold">사용자 <span class="text-base font-normal text-muted">{users.length}명</span></h1>
  <p class="mt-1 text-sm text-muted">마지막 로그인은 남아 있는 세션 기준이에요(로그아웃하면 사라짐).</p>

  <ul class="mt-6 space-y-3">
    {
      users.map((u) => (
        <li class="rounded-[var(--radius)] border border-border bg-surface p-4">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="font-semibold break-all">{u.email}</p>
              {u.isBlocked && <p class="mt-1 text-sm text-danger">⛔ 차단됨</p>}
            </div>
            {u.id !== me && (
              <form method="post" action={`/api/admin/users/${u.id}/block`}>
                <input type="hidden" name="blocked" value={u.isBlocked ? '0' : '1'} />
                <button class:list={['btn shrink-0 text-sm whitespace-nowrap', !u.isBlocked && 'btn-outline btn-error']}>
                  {u.isBlocked ? '차단 해제' : '차단'}
                </button>
              </form>
            )}
          </div>
          <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
            <dt class="text-muted">가입</dt><dd>{formatKst(u.createdAt)}</dd>
            <dt class="text-muted">방식</dt><dd>{methodOf(u.id)}</dd>
            <dt class="text-muted">마지막 로그인</dt><dd>{formatKst(lastOf(u.id))}</dd>
          </dl>
        </li>
      ))
    }
  </ul>
</AdminLayout>
