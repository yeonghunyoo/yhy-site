---
// 사용량 한 줄: 이름, 사용/한도, 막대. 80% 이상 "주의", 100% 이상 빨강(docs/guides/cost-guard.md).
// 막대는 SVG 속성(width)으로 그린다 — HTML style 속성은 CSP로 막혀 있다.
import { usageLevel } from '../../lib/usage-math';

interface Props {
  label: string;
  used: number;
  limit: number;
  /** 값 표시 형식 */
  format?: 'number' | 'bytes';
  note?: string;
}

const { label, used, limit, format = 'number', note } = Astro.props;
const { ratio, level } = usageLevel(used, limit);
const pct = Math.min(100, ratio * 100);
const fmt = (n: number) => {
  if (format === 'bytes') {
    if (n >= 1024 ** 3) return `${(n / 1024 ** 3).toFixed(2)}GB`;
    if (n >= 1024 ** 2) return `${(n / 1024 ** 2).toFixed(1)}MB`;
    return `${Math.round(n / 1024)}KB`;
  }
  return Math.round(n).toLocaleString('ko-KR');
};
const fill = level === 'over' ? 'fill-danger' : level === 'warn' ? 'fill-fg' : 'fill-success';
---

<div class="py-2">
  <div class="flex items-baseline justify-between gap-3 text-sm">
    <span class="min-w-0">
      {label}
      {level === 'warn' && <span class="ml-1 rounded border border-border px-1 text-xs font-semibold">주의</span>}
      {level === 'over' && <span class="ml-1 rounded border border-danger px-1 text-xs font-semibold text-danger">초과</span>}
    </span>
    <span class:list={['shrink-0 tabular-nums', level === 'over' ? 'text-danger' : 'text-muted']}>
      {fmt(used)} / {fmt(limit)} ({ratio < 0.01 && used > 0 ? '<1' : Math.round(ratio * 100)}%)
    </span>
  </div>
  <svg viewBox="0 0 100 4" preserveAspectRatio="none" class="mt-1 block h-1.5 w-full" role="img" aria-label={`${label} ${Math.round(ratio * 100)}%`}>
    <rect x="0" y="0" width="100" height="4" rx="2" class="fill-border" />
    {pct > 0 && <rect x="0" y="0" width={Math.max(pct, 1.5)} height="4" rx="2" class={fill} />}
  </svg>
  {note && <p class="mt-1 text-xs text-muted">{note}</p>}
</div>
