---
import { t, otherLocale, switchLocalePath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const other = otherLocale(locale);
---

<header
  class="sticky top-0 z-30 bg-bg/90 pt-[env(safe-area-inset-top)] backdrop-blur"
>
  <div class="container-page flex h-[var(--header-h)] items-center justify-between gap-2">
    <a href={`/${locale}/`} class="-ml-2 flex min-h-11 items-center px-2 font-display text-xl">{dict.intro.name}</a>
    <nav class="flex items-center gap-1 font-mono text-xs text-muted" aria-label="Main">
      <a href={`/${locale}/#project`} class="hidden min-h-11 items-center px-2 sm:flex">{dict.nav.project}</a>
      <a href={`/${locale}/#career`} class="hidden min-h-11 items-center px-2 sm:flex">{dict.nav.career}</a>
      <a href={`/${locale}/#contact`} class="hidden min-h-11 items-center px-2 sm:flex">{dict.nav.contact}</a>
      <!-- 관리자 링크: 로그인 메뉴(AuthMenu)가 서버에 관리자인지 물어 <html data-admin>을 붙였을 때만 보인다 -->
      <a href="/admin" class="hidden min-h-11 items-center px-2 font-semibold sm:in-data-admin:flex">{dict.menu.admin}</a>
      <a
        href={switchLocalePath(Astro.url.pathname, other)}
        hreflang={other}
        lang={other}
        class="flex min-h-11 items-center px-2">{dict.nav.language}</a
      >
      <slot name="auth">
        <button type="button" class="btn text-sm" data-action="login">{dict.contact.login}</button>
      </slot>
      <!-- 모바일 메뉴: Popover API라 React 없이 열고 닫는다(바깥 탭·Esc로 닫힘) -->
      <button
        type="button"
        popovertarget="mobile-nav"
        class="-mr-2 grid size-11 place-items-center sm:hidden"
        aria-label={dict.nav.menu}
      >
        <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
      <div
        id="mobile-nav"
        popover
        class="fixed inset-x-0 top-[calc(var(--header-h)+env(safe-area-inset-top))] bottom-auto m-0 h-auto w-auto border-0 border-b border-border bg-surface p-0 text-fg shadow-xl backdrop:bg-black/20"
      >
        <ul class="container-page py-2 font-display text-xl">
          <li><a href={`/${locale}/#project`} class="flex min-h-12 items-center">{dict.nav.project}</a></li>
          <li><a href={`/${locale}/#career`} class="flex min-h-12 items-center">{dict.nav.career}</a></li>
          <li><a href={`/${locale}/#contact`} class="flex min-h-12 items-center">{dict.nav.contact}</a></li>
          <li class="hidden in-data-admin:block"><a href="/admin" class="flex min-h-12 items-center font-semibold">{dict.menu.admin}</a></li>
        </ul>
      </div>
    </nav>
  </div>
</header>

<script>
  // 같은 페이지 앵커로 이동해도 팝오버는 열려 있으므로 링크를 누르면 닫는다.
  const menu = document.getElementById('mobile-nav');
  const toggle = document.querySelector<HTMLButtonElement>('[popovertarget="mobile-nav"]');
  const supported = 'showPopover' in HTMLElement.prototype;
  // Safari 16.x(iOS 16)는 Popover API가 없다 — global.css가 [popover]를 숨기고, 여기서 .popover-open 클래스로 직접 연다(바깥 탭·Esc로 닫힘)
  const setOpen = (open: boolean) => {
    menu?.classList.toggle('popover-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  const close = () => (supported ? menu?.hidePopover() : setOpen(false));
  menu?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) close();
  });
  if (!supported && menu && toggle) {
    toggle.setAttribute('aria-controls', 'mobile-nav');
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(!menu.classList.contains('popover-open'));
    });
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  }
</script>
