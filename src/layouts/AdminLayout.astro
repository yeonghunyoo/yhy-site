---
import '../styles/global.css';
import NavProgress from '../components/ui/NavProgress.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;
const tabs = [
  { href: '/admin', label: '지표' },
  { href: '/admin/letters', label: '레터' },
  { href: '/admin/users', label: '사용자' },
  { href: '/admin/chat', label: '챗' },
  { href: '/admin/usage', label: '사용량' },
];
const current = (href: string) => (href === '/admin' ? path === '/admin' || path === '/admin/' : path.startsWith(href));

const FLASH: Record<string, string> = {
  replied: '답장을 보냈어요.',
  reply_failed: '답장 메일 전송에 실패했어요. 기록은 남았어요.',
  resent: '레터를 다시 보냈어요.',
  resend_failed: '재전송에 실패했어요.',
  blocked: '사용자를 차단하고 세션을 모두 끊었어요.',
  unblocked: '차단을 해제했어요.',
  invalid: '입력을 확인해 주세요.',
  reindexed: '벡터를 갱신했어요. 검색에 반영되기까지 몇 초 걸릴 수 있어요.',
  no_vector: 'Vectorize·Workers AI 바인딩이 없어요(docs/guides/chat-rag-setup.md).',
};
const flash = FLASH[Astro.url.searchParams.get('flash') ?? ''];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · admin</title>
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="sticky top-0 z-30 border-b border-border bg-bg/90 pt-[env(safe-area-inset-top)] backdrop-blur">
      <div class="container-page flex h-[var(--header-h)] items-center gap-1 overflow-x-auto">
        <a href="/ko/" class="-ml-2 flex min-h-11 shrink-0 items-center px-2 font-bold">admin</a>
        <nav class="flex gap-1" aria-label="Admin">
          {
            tabs.map((t) => (
              <a
                href={t.href}
                aria-current={current(t.href) ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 shrink-0 items-center rounded-[var(--radius)] px-3 text-sm',
                  current(t.href) ? 'bg-surface font-semibold' : 'text-muted',
                ]}
              >
                {t.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main class="container-page flex-1 py-6 md:py-10">
      {flash && <p class="mb-6 rounded-[var(--radius)] border border-border bg-surface px-4 py-3 text-sm" role="status">{flash}</p>}
      <slot />
    </main>
    <script>
      // 로딩 상태(docs/01-frontend.md): 폼을 보내면 누른 버튼에 aria-busy(global.css가 스피너로 그린다)를 걸고
      // 두 번 보내지 못하게 막는다. 오래 걸리는 링크(data-busy-link — 기준 질문 평가 등)도 같은 모양.
      // 뒤로 가기(bfcache)로 돌아오면 원래대로 되돌린다.
      const BUSY = 'aria-busy';
      document.addEventListener('submit', (e) => {
        const form = e.target as HTMLFormElement;
        if (form.dataset.busy) {
          e.preventDefault();
          return;
        }
        form.dataset.busy = '1';
        const button = (e.submitter ?? form.querySelector('button')) as HTMLButtonElement | null;
        if (!button) return;
        button.setAttribute(BUSY, 'true');
        // 바로 disabled를 걸면 일부 브라우저에서 전송이 취소된다 — 다음 틱에
        setTimeout(() => (button.disabled = true));
      });
      document.addEventListener('click', (e) => {
        const link = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[data-busy-link]');
        if (!link || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (link.getAttribute(BUSY) === 'true') {
          e.preventDefault();
          return;
        }
        link.setAttribute(BUSY, 'true');
        link.setAttribute('aria-disabled', 'true');
      });
      window.addEventListener('pageshow', (e) => {
        if (!e.persisted) return;
        for (const el of document.querySelectorAll(`[${BUSY}="true"]`)) {
          el.removeAttribute(BUSY);
          el.removeAttribute('aria-disabled');
          if (el instanceof HTMLButtonElement) el.disabled = false;
        }
        for (const form of document.querySelectorAll<HTMLFormElement>('form[data-busy]')) delete form.dataset.busy;
      });
    </script>
    <NavProgress />
  </body>
</html>
